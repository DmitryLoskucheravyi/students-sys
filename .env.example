DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=be_smart_school
# Для хмарного MySQL: DB_SSL=true і сертифікат провайдера в DB_SSL_CA
DB_SSL=false
DB_SSL_CA=

HOST=127.0.0.1
PORT=3000

# Довгий випадковий рядок. Зміна розлогінює всіх.
JWT_SECRET=change-me
# true, якщо сайт працює через HTTPS
COOKIE_SECURE=false

# ШІ-режим роадмапа. Ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Лише для проду
# TZ=Europe/Kyiv
# TRUST_PROXY=2
# INITIAL_MANAGER_PASSWORD=
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
